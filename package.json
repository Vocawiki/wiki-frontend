{
	"name": "vocawiki-frontend",
	"scripts": {
		"format": "oxfmt",
		"check:type": "tsc --project tsconfig.app.json --noEmit && tsc --project tsconfig.node.json --noEmit",
		"check:lint": "eslint .",
		"check": "pnpm run check:type && pnpm run check:lint",
		"dev": "bun run --bun --tsconfig-override tsconfig.node.json scripts/dev && vite scripts/dev/site",
		"build": "bun run --bun --tsconfig-override tsconfig.node.json scripts/build",
		"deploy": "bun run --bun --tsconfig-override tsconfig.node.json scripts/deploy",
		"before-commit": "pnpm run format && pnpm run check && pnpm run build"
	},
	"private": true,
	"type": "module",
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@tailwindcss/postcss": "^4.2.2",
		"@tailwindcss/vite": "^4.2.2",
		"@types/bun": "^1.3.11",
		"@types/fs-extra": "^11.0.4",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.1",
		"@vitejs/plugin-rsc": "^0.5.21",
		"bun": "^1.3.11",
		"eslint": "^10.1.0",
		"eslint-plugin-react": "^7.37.5",
		"fs-extra": "^11.3.4",
		"globals": "^17.4.0",
		"globby": "^16.1.1",
		"lightningcss": "^1.32.0",
		"oxfmt": "^0.41.0",
		"postcss": "^8.5.8",
		"radashi": "^12.7.2",
		"react-dom": "^19.2.4",
		"rolldown": "1.0.0-rc.10",
		"rsc-html-stream": "^0.0.7",
		"tailwindcss": "^4.2.2",
		"type-fest": "^5.5.0",
		"types-mediawiki": "^2.0.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.57.1",
		"vite": "8.0.1",
		"wiki-saikou": "^7.6.0",
		"zod": "^4.3.6"
	},
	"dependencies": {
		"clsx": "^2.1.1",
		"fast-average-color": "^9.5.0",
		"react": "^19.2.4",
		"tailwind-merge": "^3.5.0",
		"ts-extras": "^1.3.0",
		"ts-md5": "^2.0.1"
	},
	"packageManager": "pnpm@11.17.0+sha512.cca3cea332ad254bb84145f966d19f4879615210346fc92c79a047f23a0d7b3cca3c3792f0076ba1f1831d277efbcf0a9119b31a9a60eca7fb3d6231f331ef72"
}
