{
	"name": "vocawiki-frontend",
	"scripts": {
		"format": "oxfmt",
		"check:type": "tsc --project tsconfig.app.json --noEmit && tsc --project tsconfig.node.json --noEmit",
		"check:lint": "eslint .",
		"check": "pnpm run check:type && pnpm run check:lint",
		"dev": "bun run --bun --tsconfig-override tsconfig.node.json scripts/dev && vite scripts/dev/site",
		"build": "bun run --bun --tsconfig-override tsconfig.node.json scripts/build",
		"deploy": "bun run --bun --tsconfig-override tsconfig.node.json scripts/deploy",
		"before-commit": "pnpm run format && pnpm run check && pnpm run build"
	},
	"private": true,
	"type": "module",
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@tailwindcss/postcss": "^4.3.3",
		"@tailwindcss/vite": "^4.3.3",
		"@types/bun": "^1.4.2",
		"@types/fs-extra": "^11.0.4",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.7",
		"@typescript/native": "npm:typescript@^7.0.2",
		"@vitejs/plugin-react": "^6.1.1",
		"@vitejs/plugin-rsc": "^0.5.34",
		"@wikimedia/codex": "^2.6.2",
		"@wikimedia/codex-icons": "^2.6.2",
		"bun": "^1.4.2",
		"cloudflare": "^7.1.0",
		"eslint": "^10.10.0",
		"eslint-plugin-react": "^7.37.5",
		"fs-extra": "^11.4.0",
		"globals": "^17.12.0",
		"globby": "^16.2.4",
		"lightningcss": "^1.33.0",
		"oxfmt": "^0.67.0",
		"postcss": "^8.5.28",
		"radashi": "^12.9.2",
		"react-dom": "^19.2.8",
		"rolldown": "1.2.7",
		"rsc-html-stream": "^0.0.8",
		"tailwindcss": "^4.3.3",
		"type-fest": "^5.9.0",
		"types-mediawiki": "^2.1.0",
		"typescript": "npm:@typescript/typescript6@^6.0.2",
		"typescript-eslint": "^8.70.0",
		"vite": "8.2.2",
		"vue": "^3.5.42",
		"wiki-saikou": "^7.6.0",
		"zod": "^4.5.4"
	},
	"dependencies": {
		"@base-ui/react": "^1.8.0",
		"clsx": "^2.1.1",
		"fast-average-color": "^9.5.2",
		"p-map": "^7.0.7",
		"p-queue": "^9.3.3",
		"react": "^19.2.8",
		"tailwind-merge": "^3.6.0",
		"ts-extras": "^1.3.0",
		"ts-md5": "^2.0.1"
	},
	"packageManager": "pnpm@12.3.4+sha512.961aa41fb077da3a04a441d9f8e15ebc0c96da8ef710b2eb67bf9ee7cb0610eabd48f1fd85f51cffe73846785fa0f87c56a3a872a1d893f8446741b5cce45457"
}
