		"radashi": "^12.9.6",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"ts-extras": "^1.3.0",
		"ts-md5": "^2.0.1",
		"wiki-saikou": "^7.6.0",
		"zod": "^4.6.7"
	},
	"devDependencies": {
