{
	"name": "vocawiki-frontend",
	"scripts": {
		"format": "oxfmt",
		"check:type": "tsc --project tsconfig.app.json --noEmit && tsc --project tsconfig.node.json --noEmit",
		"check:lint": "eslint .",
		"check": "pnpm run check:type && pnpm run check:lint",
		"dev": "bun run --bun --tsconfig-override tsconfig.node.json scripts/dev && vite scripts/dev/site",
		"build": "bun run --bun --tsconfig-override tsconfig.node.json scripts/build",
		"deploy": "bun run --bun --tsconfig-override tsconfig.node.json scripts/deploy",
		"before-commit": "pnpm run format && pnpm run check && pnpm run build"
	},
	"private": true,
	"type": "module",
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@tailwindcss/postcss": "^4.3.3",
		"@tailwindcss/vite": "^4.3.3",
		"@types/bun": "^1.3.14",
		"@types/fs-extra": "^11.0.4",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@typescript/native": "npm:typescript@^7.0.2",
		"@vitejs/plugin-react": "^6.0.4",
		"@vitejs/plugin-rsc": "^0.5.29",
		"@wikimedia/codex": "^2.6.2",
		"@wikimedia/codex-icons": "^2.6.2",
		"bun": "^1.3.14",
		"eslint": "^10.7.0",
		"eslint-plugin-react": "^7.37.5",
		"fs-extra": "^11.3.6",
		"globals": "^17.7.0",
		"globby": "^16.2.2",
		"lightningcss": "^1.33.0",
		"oxfmt": "^0.60.0",
		"postcss": "^8.5.22",
		"radashi": "^12.9.1",
		"react-dom": "^19.2.8",
		"rolldown": "1.2.0",
		"rsc-html-stream": "^0.0.7",
		"tailwindcss": "^4.3.3",
		"type-fest": "^5.8.0",
		"types-mediawiki": "^2.1.0",
		"typescript": "npm:@typescript/typescript6@^6.0.2",
		"typescript-eslint": "^8.65.0",
		"vite": "8.1.5",
		"vue": "^3.5.41",
		"wiki-saikou": "^7.6.0",
		"zod": "^4.4.3"
	},
	"dependencies": {
		"@base-ui/react": "^1.6.0",
		"clsx": "^2.1.1",
		"fast-average-color": "^9.5.2",
		"p-queue": "^9.3.3",
		"react": "^19.2.8",
		"tailwind-merge": "^3.6.0",
		"temporal-polyfill": "^1.0.2",
		"ts-extras": "^1.3.0",
		"ts-md5": "^2.0.1"
	},
	"packageManager": "pnpm@11.17.0+sha512.cca3cea332ad254bb84145f966d19f4879615210346fc92c79a047f23a0d7b3cca3c3792f0076ba1f1831d277efbcf0a9119b31a9a60eca7fb3d6231f331ef72"
}
