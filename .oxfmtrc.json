{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"endOfLine": "lf",
	"printWidth": 100,
	"tabWidth": 2,
	"useTabs": true,
	"semi": false,
	"singleQuote": true,
	"sortImports": {
		"newlinesBetween": false,
		"customGroups": [
			{
				"groupName": "directive_like",
				"elementNamePattern": ["@/lib/server-only"]
			}
		],
		"groups": [
			"directive_like",
			{ "newlinesBetween": true },
			"builtin",
			{ "newlinesBetween": true },
			"external",
			{ "newlinesBetween": true },
			"internal",
			{ "newlinesBetween": true },
			"parent",
			"sibling",
			"index",
			{ "newlinesBetween": true },
			"side_effect",
			"style",
			"unknown"
		]
	},
	"sortPackageJson": false,
	"sortTailwindcss": {
		"stylesheet": "./src/theme.css",
		"functions": ["cn", "cva"]
	},
	"overrides": [
		{
			"files": ["*.{css,scss,sass,less}"],
			"options": {
				"tabWidth": 4,
				"singleQuote": false
			}
		}
	],
	"ignorePatterns": ["pnpm-lock.yaml"]
}
